{
  "name": "@project-kj/wallet-service",
  "version": "0.1.0",
  "private": true,
  "description": "Watch-only HD wallet and UTXO payment service for Project KJ.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run prisma:generate && npm run typecheck && npm test && npm run build && npm run smoke:compiled",
    "dev": "node --watch -r ts-node/register src/main.ts",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "smoke:compiled": "node scripts/smoke-compiled.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@prisma/client": "6.19.3",
    "bip32": "5.0.1",
    "bitcoinjs-lib": "7.0.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.4.2",
    "json-bigint": "1.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tiny-secp256k1": "2.2.4"
  },
  "devDependencies": {
    "@types/json-bigint": "1.0.4",
    "@types/node": "24.13.3",
    "prisma": "6.19.3",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
