# Runtime
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://wallet:wallet@localhost:5432/wallet?schema=public
# Generate a random value of at least 32 characters. Sent as x-internal-api-key.
INTERNAL_API_KEY=

# Bitcoin BIP44 account exported OFFLINE from m/44'/0'/0'.
# The server derives only non-hardened 0/index children.
BITCOIN_ACCOUNT_KEY_REF=bitcoin-mainnet-bip44-v1
BITCOIN_ACCOUNT_XPUB=
BITCOIN_ACCOUNT_PATH=m/44'/0'/0'
BITCOIN_MASTER_FINGERPRINT=
# Production endpoints must use HTTPS. Development permits loopback HTTP only.
BITCOIN_ESPLORA_URL=

# Dogecoin BIP44 account exported OFFLINE from m/44'/3'/0'.
# Use Dogecoin's dgub extended-public-key serialization, not a Bitcoin xpub.
DOGECOIN_ACCOUNT_KEY_REF=dogecoin-mainnet-bip44-v1
DOGECOIN_ACCOUNT_XPUB=
DOGECOIN_ACCOUNT_PATH=m/44'/3'/0'
DOGECOIN_MASTER_FINGERPRINT=
# Must implement the Esplora-compatible API and report Dogecoin's genesis.
DOGECOIN_ESPLORA_URL=

# No external chain calls are made unless monitoring is explicitly enabled.
PAYMENT_MONITOR_ENABLED=false
PAYMENT_MONITOR_INTERVAL_MS=20000
PAYMENT_MONITOR_CONCURRENCY=4
PAYMENT_MONITOR_BATCH_SIZE=100
PAYMENT_MONITOR_LEASE_MS=120000
PAYMENT_MONITOR_RETENTION_DAYS=30
ESPLORA_REQUEST_TIMEOUT_MS=10000
ESPLORA_MAX_HISTORY_PAGES=40
